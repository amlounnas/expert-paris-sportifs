def match_team_names(name1, name2):
    """Vérifie si deux noms d'équipes correspondent"""
    n1 = normalize_team_name(name1)
    n2 = normalize_team_name(name2)

    # Matching exact après normalisation
    if n1 == n2:
        return True

    # Vérifier via aliases
    n1_alias = TEAM_ALIASES_MATCHING.get(n1, n1)
    n2_alias = TEAM_ALIASES_MATCHING.get(n2, n2)
    if n1_alias == n2_alias:
        return True

    # Matching partiel (un nom contient l'autre ou vice versa)
    if len(n1) >= 4 and len(n2) >= 4:
        if n1 in n2 or n2 in n1:
            return True

    # Comparer les mots clés (au moins un mot significatif en commun)
    words1 = set(w for w in n1.split() if len(w) >= 4)
    words2 = set(w for w in n2.split() if len(w) >= 4)
    if words1 and words2:
        common = words1 & words2
        if common:
            return True

    # Cas spécial: comparer le premier mot significatif
    if words1 and words2:
        # Si un des mots est contenu dans l'autre
        for w1 in words1:
            for w2 in words2:
                if len(w1) >= 4 and len(w2) >= 4:
                    if w1 in w2 or w2 in w1:
                        return True

    return False

def get_real_odds(competition_code):
    """Récupère les vraies cotes du marché"""
    odds_key = COMPETITIONS.get(competition_code, {}).get("odds_key")
    if not odds_key:
        return {}

    data = fetch_odds_api(odds_key)
    if not data:
        return {}

    odds_list = []  # Liste avec les noms originaux pour matching flexible
    for event in data:
        home = event.get("home_team", "")
        away = event.get("away_team", "")

        best_odds = {"1": 0, "N": 0, "2": 0, "+2.5": 0, "-2.5": 0}

        for bookmaker in event.get("bookmakers", []):
            for market in bookmaker.get("markets", []):
                if market["key"] == "h2h":
                    for outcome in market["outcomes"]:
                        if outcome["name"] == home:
                            best_odds["1"] = max(best_odds["1"], outcome["price"])
                        elif outcome["name"] == away:
                            best_odds["2"] = max(best_odds["2"], outcome["price"])
                        elif outcome["name"] == "Draw":
                            best_odds["N"] = max(best_odds["N"], outcome["price"])

                elif market["key"] == "totals":
                    for outcome in market["outcomes"]:
                        if outcome["name"] == "Over" and outcome.get("point") == 2.5:
                            best_odds["+2.5"] = max(best_odds["+2.5"], outcome["price"])
                        elif outcome["name"] == "Under" and outcome.get("point") == 2.5:
                            best_odds["-2.5"] = max(best_odds["-2.5"], outcome["price"])

        odds_list.append({
            "home": home,
            "away": away,
            "odds": best_odds
        })

    return odds_list

def find_odds_for_match(match_home, match_away, odds_list):
    """Trouve les cotes pour un match avec matching flexible"""
    for odds_event in odds_list:
        odds_home = odds_event["home"]
        odds_away = odds_event["away"]

        # Vérifier si les deux équipes matchent
        home_match = match_team_names(match_home, odds_home)
        away_match = match_team_names(match_away, odds_away)

        if home_match and away_match:
            return odds_event["odds"]

    return {}

def get_weather_factor(home_team, match_datetime):
