        description = weather["weather"][0]["description"]

        factor = 1.0
        icon = "☀️"

        # Pluie = moins de buts
        if rain > 0:
            factor *= 0.92
            icon = "🌧️"

        # Vent fort = moins de buts
        if wind > 10:
            factor *= 0.95
            icon = "💨"

        # Températures extrêmes
        if temp < 5:
            factor *= 0.95
            icon = "🥶"
        elif temp > 30:
            factor *= 0.93
            icon = "🥵"

        return {
            "factor": factor,
            "description": f"{temp:.0f}°C, {description}",
            "icon": icon,
            "temp": temp,
            "wind": wind,
            "rain": rain
        }
    except:
        return {"factor": 1.0, "description": "N/A", "icon": "❓"}

# ============== MODÈLE STATISTIQUE ==============
def poisson_prob(lam, k):
    """Probabilité de Poisson"""
    if lam <= 0:
        return 1.0 if k == 0 else 0.0
    return (exp(-lam) * (lam ** k)) / factorial(min(k, 170))

def calculate_weighted_stats(team, standings, recent_form, location):
    """Stats pondérées par récence"""
    base_stats = standings.get(team, {})
    if not base_stats or base_stats.get("played", 0) < 3:
        return None

    if location == "home":
        played = base_stats.get("home_played", 0) or base_stats["played"] / 2
        base_gf = base_stats.get("home_gf", base_stats["gf"] / 2)
        base_ga = base_stats.get("home_ga", base_stats["ga"] / 2)
    else:
        played = base_stats.get("away_played", 0) or base_stats["played"] / 2
        base_gf = base_stats.get("away_gf", base_stats["gf"] / 2)
        base_ga = base_stats.get("away_ga", base_stats["ga"] / 2)

    if played < 2:
        played = base_stats["played"] / 2
        base_gf = base_stats["gf"] / 2
        base_ga = base_stats["ga"] / 2

    team_form = recent_form.get(team, [])
    if len(team_form) >= 3:
        weighted_gf, weighted_ga, total_weight = 0, 0, 0
        now = datetime.now()

        for match in sorted(team_form, key=lambda x: x["date"], reverse=True)[:10]:
            days_ago = (now - match["date"].replace(tzinfo=None)).days
            weight = exp(-days_ago / 30)
            if match["loc"] == location:
                weight *= 1.3
            weighted_gf += match["gf"] * weight
            weighted_ga += match["ga"] * weight
            total_weight += weight

        if total_weight > 0:
            season_avg_gf = base_gf / max(played, 1)
            season_avg_ga = base_ga / max(played, 1)
            recent_avg_gf = weighted_gf / total_weight
            recent_avg_ga = weighted_ga / total_weight

            return {
                "attack": 0.6 * recent_avg_gf + 0.4 * season_avg_gf,
                "defense": 0.6 * recent_avg_ga + 0.4 * season_avg_ga,
                "form_score": calculate_form_score(base_stats.get("form", "")),
                "position": base_stats["position"]
            }

    return {
        "attack": base_gf / max(played, 1),
        "defense": base_ga / max(played, 1),
        "form_score": calculate_form_score(base_stats.get("form", "")),
        "position": base_stats["position"]
    }

def calculate_form_score(form_string):
    """Score de forme pondéré"""
    if not form_string:
        return 0.5
    score = 0
    weights = [1.5, 1.3, 1.1, 0.9, 0.7]
    for i, result in enumerate(form_string.replace(",", "")[:5]):
        w = weights[i] if i < len(weights) else 0.5
        if result == "W":
            score += 3 * w
        elif result == "D":
            score += 1 * w
    max_score = sum(w * 3 for w in weights[:len(form_string[:5])])
    return score / max_score if max_score > 0 else 0.5

# ============== NOUVELLES FONCTIONS ML AVANCÉES ==============
def calculate_h2h_factor(home_team, away_team, h2h_data):
    """Calcule le facteur basé sur les confrontations directes"""
    h2h_key = tuple(sorted([home_team, away_team]))
    matches = h2h_data.get(h2h_key, [])

    if len(matches) < 2:
        return {"home_factor": 1.0, "away_factor": 1.0, "avg_goals": None, "matches": 0}

    home_wins, away_wins, draws = 0, 0, 0
    total_home_goals, total_away_goals = 0, 0

    for m in matches[-5:]:  # 5 dernières confrontations
        if m["home"] == home_team:
            hg, ag = m["home_goals"], m["away_goals"]
        else:
            hg, ag = m["away_goals"], m["home_goals"]

        total_home_goals += hg
        total_away_goals += ag

        if hg > ag:
            home_wins += 1
        elif ag > hg:
            away_wins += 1
        else:
            draws += 1

    n = len(matches[-5:])
    home_win_rate = home_wins / n
    away_win_rate = away_wins / n

    # Facteur H2H (max ±15%)
    home_factor = 1.0 + (home_win_rate - 0.5) * 0.3
    away_factor = 1.0 + (away_win_rate - 0.5) * 0.3

    return {
        "home_factor": max(0.85, min(1.15, home_factor)),
        "away_factor": max(0.85, min(1.15, away_factor)),
        "avg_goals": (total_home_goals + total_away_goals) / n if n > 0 else None,
        "matches": n,
        "home_wins": home_wins,
        "away_wins": away_wins,
        "draws": draws
    }

def calculate_momentum(recent_form, team):
    """Calcule le momentum (série en cours)"""
    matches = recent_form.get(team, [])
    if len(matches) < 3:
        return {"factor": 1.0, "streak": 0, "streak_type": None}

    # Trier par date décroissante
    sorted_matches = sorted(matches, key=lambda x: x["date"], reverse=True)[:5]

    # Détecter série
    streak = 0
    streak_type = None

    for m in sorted_matches:
        result = m.get("result", "D")
        if streak == 0:
            streak_type = result
            streak = 1
        elif result == streak_type:
            streak += 1
        else:
            break

    # Facteur momentum
    factor = 1.0
    if streak >= 3:
        if streak_type == "W":
            factor = 1.0 + (streak - 2) * 0.03  # +3% par victoire après 2
        elif streak_type == "L":
            factor = 1.0 - (streak - 2) * 0.03  # -3% par défaite après 2

    # Limiter à ±12%
    factor = max(0.88, min(1.12, factor))

    return {
        "factor": factor,
        "streak": streak,
        "streak_type": streak_type
    }

def calculate_match_importance(home_stats, away_stats, total_teams=20):
    """Calcule l'importance du match (fin de saison, enjeux)"""
    home_pos = home_stats.get("position", 10)
    away_pos = away_stats.get("position", 10)
    played = home_stats.get("played", 0)

    # Fin de saison (après 28 matchs sur 38)
    season_progress = played / 38 if played > 0 else 0
    is_late_season = season_progress > 0.75

    importance = 1.0

    if is_late_season:
        # Lutte pour le titre (top 2)
        if home_pos <= 2 or away_pos <= 2:
            importance += 0.05

        # Lutte pour la Ligue des Champions (top 4)
        if 3 <= home_pos <= 6 or 3 <= away_pos <= 6:
            importance += 0.03

        # Lutte pour le maintien (bottom 3)
        if home_pos >= total_teams - 2 or away_pos >= total_teams - 2:
            importance += 0.05

        # Derby ou match de rivalité (positions proches)
        if abs(home_pos - away_pos) <= 3:
            importance += 0.02

    return {
        "factor": min(1.15, importance),
        "is_late_season": is_late_season,
        "title_race": home_pos <= 2 or away_pos <= 2,
        "relegation_battle": home_pos >= total_teams - 2 or away_pos >= total_teams - 2,
        "european_race": 3 <= home_pos <= 6 or 3 <= away_pos <= 6
    }

def calculate_goals_trend(recent_form, team, location=None):
    """Analyse la tendance des buts marqués/encaissés"""
    matches = recent_form.get(team, [])
    if len(matches) < 3:
        return {"scoring_trend": 1.0, "conceding_trend": 1.0}

    sorted_matches = sorted(matches, key=lambda x: x["date"], reverse=True)

    # Filtrer par location si spécifié
    if location:
        sorted_matches = [m for m in sorted_matches if m.get("loc") == location]

    if len(sorted_matches) < 3:
        return {"scoring_trend": 1.0, "conceding_trend": 1.0}

    # Comparer les 3 derniers aux 3 précédents
    recent_3 = sorted_matches[:3]
    previous_3 = sorted_matches[3:6] if len(sorted_matches) >= 6 else sorted_matches[3:]

    if not previous_3:
        return {"scoring_trend": 1.0, "conceding_trend": 1.0}

    recent_gf = sum(m["gf"] for m in recent_3) / len(recent_3)
    recent_ga = sum(m["ga"] for m in recent_3) / len(recent_3)
    prev_gf = sum(m["gf"] for m in previous_3) / len(previous_3)
    prev_ga = sum(m["ga"] for m in previous_3) / len(previous_3)

    # Tendance (max ±10%)
    scoring_trend = 1.0
    if prev_gf > 0:
        scoring_trend = min(1.10, max(0.90, recent_gf / prev_gf))

    conceding_trend = 1.0
    if prev_ga > 0:
        conceding_trend = min(1.10, max(0.90, recent_ga / prev_ga))

    return {
        "scoring_trend": scoring_trend,
        "conceding_trend": conceding_trend,
        "recent_avg_gf": recent_gf,
        "recent_avg_ga": recent_ga
    }

# ============== MODÈLES SPÉCIFIQUES PAR TYPE DE PARI ==============
def model_1x2(home_xg, away_xg):
    """Modèle optimisé pour 1X2"""
    probs = {"1": 0, "N": 0, "2": 0}
    for h in range(10):
        for a in range(10):
            p = poisson_prob(home_xg, h) * poisson_prob(away_xg, a)
            if h > a:
                probs["1"] += p
            elif h == a:
                probs["N"] += p
            else:
                probs["2"] += p
    return probs

def model_over_under(home_xg, away_xg, weather_factor=1.0):
    """Modèle optimisé pour Over/Under avec météo"""
    total_xg = (home_xg + away_xg) * weather_factor

    probs = {"+2.5": 0, "-2.5": 0, "+1.5": 0, "-1.5": 0, "+3.5": 0, "-3.5": 0}
    for h in range(10):
        for a in range(10):
            p = poisson_prob(home_xg * weather_factor, h) * poisson_prob(away_xg * weather_factor, a)
            total = h + a
            if total > 2.5:
                probs["+2.5"] += p
            else:
                probs["-2.5"] += p
            if total > 1.5:
                probs["+1.5"] += p
            else:
                probs["-1.5"] += p
            if total > 3.5:
                probs["+3.5"] += p
            else:
                probs["-3.5"] += p
    return probs

def model_btts(home_xg, away_xg, weather_factor=1.0):
    """Modèle optimisé pour BTTS"""
    probs = {"BTTS_yes": 0, "BTTS_no": 0}
    for h in range(10):
        for a in range(10):
            p = poisson_prob(home_xg * weather_factor, h) * poisson_prob(away_xg * weather_factor, a)
            if h > 0 and a > 0:
                probs["BTTS_yes"] += p
            else:
                probs["BTTS_no"] += p
    return probs

def analyze_match_ultimate(match, standings, recent_form, league_avg, real_odds, weather_data, h2h_data=None):
    """Analyse ultime avec tous les facteurs ML avancés"""
    home_team = match["home"]
    away_team = match["away"]

    home_stats = calculate_weighted_stats(home_team, standings, recent_form, "home")
    away_stats = calculate_weighted_stats(away_team, standings, recent_form, "away")

    if not home_stats or not away_stats:
        return None

    avg_goals = league_avg.get("avg_goals", 1.35)

    # ============== FACTEURS DE BASE ==============
    home_attack_strength = home_stats["attack"] / avg_goals
    home_defense_strength = home_stats["defense"] / avg_goals
    away_attack_strength = away_stats["attack"] / avg_goals
    away_defense_strength = away_stats["defense"] / avg_goals

    # Avantage domicile de base
    home_advantage = 1.15

    # xG de base
    home_xg = avg_goals * home_attack_strength * away_defense_strength * home_advantage
    away_xg = avg_goals * away_attack_strength * home_defense_strength / home_advantage

    # ============== NOUVEAUX FACTEURS ML ==============

    # 1. Confrontations directes (H2H)
    h2h_factor = {"home_factor": 1.0, "away_factor": 1.0, "matches": 0}
    if h2h_data:
        h2h_factor = calculate_h2h_factor(home_team, away_team, h2h_data)
        home_xg *= h2h_factor["home_factor"]
        away_xg *= h2h_factor["away_factor"]

    # 2. Momentum (séries en cours)
    home_momentum = calculate_momentum(recent_form, home_team)
    away_momentum = calculate_momentum(recent_form, away_team)
    home_xg *= home_momentum["factor"]
    away_xg *= away_momentum["factor"]

    # 3. Importance du match
    importance = calculate_match_importance(
        standings.get(home_team, {}),
        standings.get(away_team, {}),
        total_teams=len([t for t in standings if standings[t].get("played", 0) > 0])
    )

    # 4. Tendance des buts
    home_trend = calculate_goals_trend(recent_form, home_team, "home")
    away_trend = calculate_goals_trend(recent_form, away_team, "away")
    home_xg *= home_trend["scoring_trend"]
    away_xg *= away_trend["scoring_trend"]

    # 5. Ajustement forme (existant)
    form_factor_home = 0.9 + (home_stats["form_score"] * 0.2)
    form_factor_away = 0.9 + (away_stats["form_score"] * 0.2)
    home_xg *= form_factor_home
    away_xg *= form_factor_away

    # ============== LIMITES FINALES ==============
    home_xg = max(0.3, min(4.0, home_xg))
    away_xg = max(0.2, min(3.5, away_xg))

    # Facteur météo
    weather_factor = weather_data.get("factor", 1.0)

    # ============== CALCUL DES PROBABILITÉS ==============
    probs_1x2 = model_1x2(home_xg, away_xg)
    probs_ou = model_over_under(home_xg, away_xg, weather_factor)
    probs_btts = model_btts(home_xg, away_xg, weather_factor)

    all_probs = {**probs_1x2, **probs_ou, **probs_btts}

    # ============== SCORE DE CONFIANCE GLOBAL ==============
    # Plus de données = plus de confiance
    confidence_boost = 0
    if h2h_factor["matches"] >= 3:
        confidence_boost += 0.02  # +2% si H2H fiable
    if home_momentum["streak"] >= 3 or away_momentum["streak"] >= 3:
        confidence_boost += 0.01  # +1% si momentum clair
    if importance["is_late_season"]:
        confidence_boost += 0.01  # +1% en fin de saison (stats plus fiables)

    return {
        "match": f"{home_team} vs {away_team}",
        "home": home_team,
        "away": away_team,
        "date": match["date"],
        "datetime": match.get("datetime"),
        "competition": match["competition"],
        "comp_name": match["comp_name"],
        "comp_flag": match["comp_flag"],
        "home_xg": round(home_xg, 2),
        "away_xg": round(away_xg, 2),
        "home_form": home_stats["form_score"],
        "away_form": away_stats["form_score"],
        "home_pos": home_stats["position"],
        "away_pos": away_stats["position"],
        "probs": all_probs,
        "real_odds": real_odds,
        "weather": weather_data,
        # Nouveaux facteurs ML
        "h2h": h2h_factor,
        "home_momentum": home_momentum,
        "away_momentum": away_momentum,
        "importance": importance,
        "confidence_boost": confidence_boost
    }

def find_value_bets_ultimate(analysis):
    """Trouve les value bets UNIQUEMENT avec vraies cotes (pas de simulation)"""
    value_bets = []

    bet_types = {
        "1": {"name": "Victoire domicile", "prob_key": "1"},
        "N": {"name": "Match nul", "prob_key": "N"},
        "2": {"name": "Victoire extérieur", "prob_key": "2"},
        "+2.5": {"name": "Plus de 2.5 buts", "prob_key": "+2.5"},
        "-2.5": {"name": "Moins de 2.5 buts", "prob_key": "-2.5"}
    }

    real_odds = analysis.get("real_odds", {})

    # Si pas de vraies cotes pour ce match, on skip
    if not real_odds or all(v == 0 for v in real_odds.values()):
        return []

    # Bonus de confiance des facteurs ML
    confidence_boost = analysis.get("confidence_boost", 0)

    for bet_code, bet_info in bet_types.items():
        prob = analysis["probs"].get(bet_info["prob_key"], 0)

        # UNIQUEMENT les vraies cotes - on ignore si pas disponible
        market_odds = real_odds.get(bet_code, 0)
        if market_odds <= 0:
            continue

        # Appliquer le boost de confiance à la probabilité
        adjusted_prob = min(0.95, prob * (1 + confidence_boost))

        ev = adjusted_prob * market_odds

        # Filtres de qualité
        if ev > MIN_VALUE_THRESHOLD and adjusted_prob >= MIN_CONFIDENCE / 100:
            # Limiter l'edge à 20% max (au-delà c'est suspect)
            edge = (ev - 1) * 100
            if edge > 20:
                continue  # Edge trop élevé = données suspectes

            kelly = (adjusted_prob * market_odds - 1) / (market_odds - 1) if market_odds > 1 else 0
            kelly_fractional = max(0, min(kelly * KELLY_FRACTION, 0.10))  # Max 10% de la bankroll
            stake = round(BANKROLL * kelly_fractional, 2)

            # Score de qualité ML (plus les facteurs sont fiables, meilleur est le score)
            ml_quality = 50  # Base
            h2h = analysis.get("h2h", {})
            if h2h.get("matches", 0) >= 3:
                ml_quality += 15
            if analysis.get("home_momentum", {}).get("streak", 0) >= 3:
                ml_quality += 10
            if analysis.get("away_momentum", {}).get("streak", 0) >= 3:
                ml_quality += 10
            if analysis.get("importance", {}).get("is_late_season", False):
                ml_quality += 15

            value_bets.append({
                "type": bet_code,
                "type_name": bet_info["name"],
                "prob": adjusted_prob,
                "odds": market_odds,
                "odds_source": "RÉELLE",
                "ev": ev,
                "edge": edge,
                "kelly": kelly_fractional,
                "stake": stake,
                "confidence": int(adjusted_prob * 100),
                "is_high_value": ev >= HIGH_VALUE_THRESHOLD,
                "ml_quality": min(100, ml_quality)  # Score qualité ML (0-100)
            })

    return sorted(value_bets, key=lambda x: x["ev"], reverse=True)

