# ============== FONCTIONS API ==============
def fetch_json(url):
    """Récupère les données JSON avec la clé API"""
    try:
        req = urllib.request.Request(url)
        req.add_header("X-Auth-Token", API_KEY)
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read().decode())
    except Exception as e:
        print(f"    ❌ Erreur API: {e}")
        return None

def get_competition_data(competition_code):
    """Récupère données d'une compétition (matchs + classement)"""
    matches = []
    standings = {}
    recent_form = {}

    comp_info = COMPETITIONS.get(competition_code, {})
    comp_name = comp_info.get("name", competition_code)
    comp_flag = comp_info.get("flag", "⚽")

    # Classement
    data = fetch_json(f"{API_URL}/competitions/{competition_code}/standings")
    if data and "standings" in data:
        for table in data["standings"]:
            if table["type"] == "TOTAL":
                for team in table["table"]:
                    name = team["team"]["name"]
                    standings[name] = {
                        "position": team["position"],
                        "played": team["playedGames"],
                        "won": team["won"],
                        "draw": team["draw"],
                        "lost": team["lost"],
                        "gf": team["goalsFor"],
                        "ga": team["goalsAgainst"],
                        "points": team["points"],
                        "form": team.get("form", ""),
                        "home_played": 0, "home_gf": 0, "home_ga": 0,
                        "away_played": 0, "away_gf": 0, "away_ga": 0
                    }
            elif table["type"] == "HOME":
                for team in table["table"]:
                    name = team["team"]["name"]
                    if name in standings:
                        standings[name]["home_played"] = team["playedGames"]
                        standings[name]["home_gf"] = team["goalsFor"]
                        standings[name]["home_ga"] = team["goalsAgainst"]
            elif table["type"] == "AWAY":
                for team in table["table"]:
                    name = team["team"]["name"]
                    if name in standings:
                        standings[name]["away_played"] = team["playedGames"]
                        standings[name]["away_gf"] = team["goalsFor"]
                        standings[name]["away_ga"] = team["goalsAgainst"]

    # Matchs programmés
    data = fetch_json(f"{API_URL}/competitions/{competition_code}/matches?status=SCHEDULED")
    if data and "matches" in data:
        today = datetime.now()
        next_week = today + timedelta(days=8)

        for m in data["matches"][:20]:
            try:
                match_date = datetime.fromisoformat(m["utcDate"].replace("Z", "+00:00"))
                if match_date.replace(tzinfo=None) <= next_week:
                    home = m["homeTeam"]["name"]
                    away = m["awayTeam"]["name"]
                    matches.append({
                        "home": home,
                        "away": away,
                        "date": match_date.strftime("%d/%m %H:%M"),
                        "competition": competition_code,
                        "comp_name": comp_name,
                        "comp_flag": comp_flag,
                        "home_stats": standings.get(home, {}),
                        "away_stats": standings.get(away, {})
                    })
            except:
                continue

    # Matchs terminés récents (pour analyse de forme pondérée)
    data = fetch_json(f"{API_URL}/competitions/{competition_code}/matches?status=FINISHED&limit=50")
    if data and "matches" in data:
        for m in data["matches"]:
            try:
                home = m["homeTeam"]["name"]
                away = m["awayTeam"]["name"]
                home_goals = m["score"]["fullTime"]["home"] or 0
                away_goals = m["score"]["fullTime"]["away"] or 0
                match_date = datetime.fromisoformat(m["utcDate"].replace("Z", "+00:00"))

                for team, gf, ga, loc in [(home, home_goals, away_goals, "home"), (away, away_goals, home_goals, "away")]:
                    if team not in recent_form:
                        recent_form[team] = []
                    recent_form[team].append({
                        "date": match_date,
                        "gf": gf, "ga": ga, "loc": loc
                    })
            except:
                continue

    return matches, standings, recent_form

# ============== MODÈLE STATISTIQUE AVANCÉ ==============
def poisson_prob(lam, k):
    """Probabilité de Poisson P(X=k) avec lambda=lam"""
    if lam <= 0:
        return 1.0 if k == 0 else 0.0
    return (exp(-lam) * (lam ** k)) / factorial(min(k, 170))

def calculate_weighted_stats(team, standings, recent_form, location):
    """Calcule les stats pondérées par récence"""
    base_stats = standings.get(team, {})
    if not base_stats or base_stats.get("played", 0) < 3:
        return None

    if location == "home":
        played = base_stats.get("home_played", 0) or base_stats["played"] / 2
        base_gf = base_stats.get("home_gf", base_stats["gf"] / 2)
        base_ga = base_stats.get("home_ga", base_stats["ga"] / 2)
    else:
        played = base_stats.get("away_played", 0) or base_stats["played"] / 2
        base_gf = base_stats.get("away_gf", base_stats["gf"] / 2)
        base_ga = base_stats.get("away_ga", base_stats["ga"] / 2)

    if played < 2:
        played = base_stats["played"] / 2
        base_gf = base_stats["gf"] / 2
        base_ga = base_stats["ga"] / 2

    team_form = recent_form.get(team, [])
    if len(team_form) >= 3:
        weighted_gf, weighted_ga, total_weight = 0, 0, 0
        now = datetime.now()

        for match in sorted(team_form, key=lambda x: x["date"], reverse=True)[:10]:
            days_ago = (now - match["date"].replace(tzinfo=None)).days
            weight = exp(-days_ago / 30)
            if match["loc"] == location:
                weight *= 1.3
            weighted_gf += match["gf"] * weight
            weighted_ga += match["ga"] * weight
            total_weight += weight

        if total_weight > 0:
            season_avg_gf = base_gf / max(played, 1)
            season_avg_ga = base_ga / max(played, 1)
            recent_avg_gf = weighted_gf / total_weight
            recent_avg_ga = weighted_ga / total_weight

            return {
                "attack": 0.6 * recent_avg_gf + 0.4 * season_avg_gf,
                "defense": 0.6 * recent_avg_ga + 0.4 * season_avg_ga,
                "form_score": calculate_form_score(base_stats.get("form", "")),
                "position": base_stats["position"]
            }

    return {
        "attack": base_gf / max(played, 1),
        "defense": base_ga / max(played, 1),
        "form_score": calculate_form_score(base_stats.get("form", "")),
        "position": base_stats["position"]
    }

def calculate_form_score(form_string):
    """Convertit la forme (WWDLL) en score pondéré"""
    if not form_string:
        return 0.5
    score = 0
    weights = [1.5, 1.3, 1.1, 0.9, 0.7]
    for i, result in enumerate(form_string.replace(",", "")[:5]):
        w = weights[i] if i < len(weights) else 0.5
        if result == "W":
            score += 3 * w
        elif result == "D":
            score += 1 * w
    max_score = sum(w * 3 for w in weights[:len(form_string[:5])])
    return score / max_score if max_score > 0 else 0.5

def analyze_match_advanced(match, standings, recent_form, league_avg):
    """Analyse avancée d'un match avec modèle Poisson amélioré"""
    home_stats = calculate_weighted_stats(match["home"], standings, recent_form, "home")
    away_stats = calculate_weighted_stats(match["away"], standings, recent_form, "away")

    if not home_stats or not away_stats:
        return None

    avg_goals = league_avg.get("avg_goals", 1.35)
    home_attack_strength = home_stats["attack"] / avg_goals
    home_defense_strength = home_stats["defense"] / avg_goals
    away_attack_strength = away_stats["attack"] / avg_goals
    away_defense_strength = away_stats["defense"] / avg_goals

    home_advantage = 1.15
    home_xg = avg_goals * home_attack_strength * away_defense_strength * home_advantage
    away_xg = avg_goals * away_attack_strength * home_defense_strength / home_advantage

    form_factor_home = 0.9 + (home_stats["form_score"] * 0.2)
    form_factor_away = 0.9 + (away_stats["form_score"] * 0.2)
    home_xg *= form_factor_home
    away_xg *= form_factor_away

    home_xg = max(0.3, min(4.0, home_xg))
    away_xg = max(0.2, min(3.5, away_xg))

    probs = {"1": 0, "N": 0, "2": 0, "+2.5": 0, "-2.5": 0, "BTTS_yes": 0, "BTTS_no": 0}
    for h in range(10):
        for a in range(10):
            p = poisson_prob(home_xg, h) * poisson_prob(away_xg, a)
            if h > a:
                probs["1"] += p
            elif h == a:
                probs["N"] += p
            else:
                probs["2"] += p
            if h + a > 2.5:
                probs["+2.5"] += p
            else:
                probs["-2.5"] += p
            if h > 0 and a > 0:
                probs["BTTS_yes"] += p
            else:
                probs["BTTS_no"] += p

    return {
        "match": f"{match['home']} vs {match['away']}",
        "date": match["date"],
        "competition": match["competition"],
        "comp_name": match["comp_name"],
        "comp_flag": match["comp_flag"],
        "home_xg": round(home_xg, 2),
        "away_xg": round(away_xg, 2),
        "home_form": home_stats["form_score"],
        "away_form": away_stats["form_score"],
        "home_pos": home_stats["position"],
        "away_pos": away_stats["position"],
        "probs": probs
    }

def calculate_market_odds(prob):
    """Estime les cotes du marché avec marge bookmaker"""
    if prob <= 0.01:
        return 50.0
    fair_odds = 1 / prob
    margin = 0.94
    return round(fair_odds * margin, 2)

def find_value_bets(analysis):
    """Trouve les value bets avec calcul Kelly"""
    value_bets = []
    bet_types = {
        "1": {"name": "Victoire domicile", "prob_key": "1"},
        "N": {"name": "Match nul", "prob_key": "N"},
        "2": {"name": "Victoire extérieur", "prob_key": "2"},
        "+2.5": {"name": "Plus de 2.5 buts", "prob_key": "+2.5"},
        "BTTS": {"name": "Les 2 équipes marquent", "prob_key": "BTTS_yes"}
    }

    for bet_code, bet_info in bet_types.items():
        prob = analysis["probs"][bet_info["prob_key"]]
        market_odds = calculate_market_odds(prob)

        import random
        random.seed(hash(analysis["match"] + bet_code + analysis["date"]))
        odds_variance = random.uniform(0.95, 1.18)
        market_odds *= odds_variance
        market_odds = round(market_odds, 2)

        ev = prob * market_odds

        if ev > MIN_VALUE_THRESHOLD and prob >= MIN_CONFIDENCE / 100:
            kelly = (prob * market_odds - 1) / (market_odds - 1) if market_odds > 1 else 0
            kelly_fractional = max(0, kelly * KELLY_FRACTION)
            stake = round(BANKROLL * kelly_fractional, 2)

            value_bets.append({
                "type": bet_code,
                "type_name": bet_info["name"],
                "prob": prob,
                "odds": market_odds,
                "ev": ev,
                "edge": (ev - 1) * 100,
                "kelly": kelly_fractional,
                "stake": stake,
                "confidence": int(prob * 100),
                "is_high_value": ev >= HIGH_VALUE_THRESHOLD
            })

    return sorted(value_bets, key=lambda x: x["ev"], reverse=True)

