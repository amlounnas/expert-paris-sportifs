def load_tracking():
    """Charge l'historique des paris"""
    try:
        if os.path.exists(TRACKING_FILE):
            with open(TRACKING_FILE, 'r') as f:
                return json.load(f)
    except:
        pass
    return {"bets": [], "stats": {"total": 0, "won": 0, "lost": 0, "pending": 0, "profit": 0}}

def save_tracking(tracking):
    """Sauvegarde l'historique"""
    try:
        with open(TRACKING_FILE, 'w') as f:
            json.dump(tracking, f, indent=2, default=str)
    except Exception as e:
        print(f"⚠️ Erreur sauvegarde tracking: {e}")

def add_bet_to_tracking(tracking, rec):
    """Ajoute un pari au tracking"""
    bet = rec["bet"]
    bet_id = hashlib.md5(f"{rec['match']}{rec['date']}{bet['type']}".encode()).hexdigest()[:8]

    tracking["bets"].append({
        "id": bet_id,
        "date": datetime.now().isoformat(),
        "match": rec["match"],
        "match_date": rec["date"],
        "competition": rec["comp_name"],
        "bet_type": bet["type"],
        "odds": bet["odds"],
        "stake": bet["stake"],
        "prob": bet["prob"],
        "ev": bet["ev"],
        "status": "pending",
        "result": None,
        "profit": None
    })
    tracking["stats"]["total"] += 1
    tracking["stats"]["pending"] += 1

    return bet_id

def calculate_tracking_stats(tracking):
    """Calcule les statistiques de performance"""
    bets = tracking["bets"]
    settled = [b for b in bets if b["status"] != "pending"]

    if not settled:
        return {
            "roi": 0,
            "total_staked": 0,
            "total_profit": 0,
            "win_rate": 0,
            "avg_odds": 0
        }

    total_staked = sum(b["stake"] for b in settled)
    total_profit = sum(b.get("profit", 0) for b in settled)
    won = len([b for b in settled if b["status"] == "won"])

    return {
        "roi": (total_profit / total_staked * 100) if total_staked > 0 else 0,
        "total_staked": total_staked,
        "total_profit": total_profit,
        "win_rate": (won / len(settled) * 100) if settled else 0,
        "avg_odds": sum(b["odds"] for b in settled) / len(settled) if settled else 0,
        "total_bets": len(settled),
        "won": won,
        "lost": len(settled) - won
    }

