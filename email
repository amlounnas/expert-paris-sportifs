def get_competition_data(competition_code):
    """Récupère données d'une compétition"""
    matches = []
    standings = {}
    recent_form = {}
    injuries = {}

    comp_info = COMPETITIONS.get(competition_code, {})
    comp_name = comp_info.get("name", competition_code)
    comp_flag = comp_info.get("flag", "⚽")

    # Classement
    data = fetch_football_api(f"/competitions/{competition_code}/standings")
    if data and "standings" in data:
        for table in data["standings"]:
            if table["type"] == "TOTAL":
                for team in table["table"]:
                    name = team["team"]["name"]
                    standings[name] = {
                        "position": team["position"],
                        "played": team["playedGames"],
                        "won": team["won"],
                        "draw": team["draw"],
                        "lost": team["lost"],
                        "gf": team["goalsFor"],
                        "ga": team["goalsAgainst"],
                        "points": team["points"],
                        "form": team.get("form", ""),
                        "home_played": 0, "home_gf": 0, "home_ga": 0,
                        "away_played": 0, "away_gf": 0, "away_ga": 0
                    }
            elif table["type"] == "HOME":
                for team in table["table"]:
                    name = team["team"]["name"]
                    if name in standings:
                        standings[name]["home_played"] = team["playedGames"]
                        standings[name]["home_gf"] = team["goalsFor"]
                        standings[name]["home_ga"] = team["goalsAgainst"]
            elif table["type"] == "AWAY":
                for team in table["table"]:
                    name = team["team"]["name"]
                    if name in standings:
                        standings[name]["away_played"] = team["playedGames"]
                        standings[name]["away_gf"] = team["goalsFor"]
                        standings[name]["away_ga"] = team["goalsAgainst"]

    # Matchs programmés
    data = fetch_football_api(f"/competitions/{competition_code}/matches?status=SCHEDULED")
    if data and "matches" in data:
        today = datetime.now()
        next_week = today + timedelta(days=8)

        for m in data["matches"][:20]:
            try:
                match_date = datetime.fromisoformat(m["utcDate"].replace("Z", "+00:00"))
                if match_date.replace(tzinfo=None) <= next_week:
                    home = m["homeTeam"]["name"]
                    away = m["awayTeam"]["name"]
                    matches.append({
                        "home": home,
                        "away": away,
                        "date": match_date.strftime("%d/%m %H:%M"),
                        "datetime": match_date,
                        "competition": competition_code,
                        "comp_name": comp_name,
                        "comp_flag": comp_flag,
                        "home_stats": standings.get(home, {}),
                        "away_stats": standings.get(away, {})
                    })
            except:
                continue

    # Matchs terminés récents (augmenté à 100 pour H2H)
    data = fetch_football_api(f"/competitions/{competition_code}/matches?status=FINISHED&limit=100")
    h2h_data = {}  # Confrontations directes

    if data and "matches" in data:
        for m in data["matches"]:
            try:
                home = m["homeTeam"]["name"]
                away = m["awayTeam"]["name"]
                home_goals = m["score"]["fullTime"]["home"] or 0
                away_goals = m["score"]["fullTime"]["away"] or 0
                match_date = datetime.fromisoformat(m["utcDate"].replace("Z", "+00:00"))

                # Forme récente par équipe
                for team, gf, ga, loc in [(home, home_goals, away_goals, "home"), (away, away_goals, home_goals, "away")]:
                    if team not in recent_form:
                        recent_form[team] = []
                    recent_form[team].append({
                        "date": match_date,
                        "gf": gf, "ga": ga, "loc": loc,
                        "opponent": away if team == home else home,
                        "result": "W" if gf > ga else ("D" if gf == ga else "L")
                    })

                # H2H - Confrontations directes
                h2h_key = tuple(sorted([home, away]))
                if h2h_key not in h2h_data:
                    h2h_data[h2h_key] = []
                h2h_data[h2h_key].append({
                    "date": match_date,
                    "home": home, "away": away,
                    "home_goals": home_goals, "away_goals": away_goals
                })
            except:
                continue

    return matches, standings, recent_form, h2h_data

def normalize_team_name(name):
    """Normalise un nom d'équipe pour le matching"""
    import re
    import unicodedata

    # Normaliser accents (é → e, ü → u, etc.)
    name = unicodedata.normalize('NFKD', name).encode('ascii', 'ignore').decode('ascii')
    name = name.lower()

    # Retirer les suffixes/préfixes courants
    name = re.sub(r'\b(fc|cf|sc|ac|afc|ssc|rc|as|ogc|vfb|vfl|tsv|fsv|sv|cd|ud|rcd|ca|hsc|osc)\b', '', name)
    name = re.sub(r'\b(1846|1848|1899|1901|1904|1905|1907|1909|1911|1919|1963|04|05|09)\b', '', name)
    name = re.sub(r'\b(de madrid|de barcelona|de futbol|balompie|de vigo)\b', '', name)
    name = re.sub(r'\bstade\b', '', name)  # "Stade Rennais" → "Rennais"
    name = re.sub(r'\bolympique\b', '', name)  # "Olympique Lyonnais" → "Lyonnais"
    name = re.sub(r'\bborussia\b', '', name)  # "Borussia Dortmund" → "Dortmund"

    # Normaliser espaces
    name = ' '.join(name.split())
    return name.strip()

